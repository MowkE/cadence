# Optional development shortcut — the app's in-UI setup is the normal path.
# Get credentials at https://developer.spotify.com/dashboard:
#   1. Create an app
#   2. Add http://127.0.0.1:8888/callback as a Redirect URI
#   3. Copy this file to .env and fill in your values (only read by `npm start`)

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Listen along relay (any ntfy server). Defaults to https://ntfy.sh
# CADENCE_RELAY=https://ntfy.example.com
