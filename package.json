{
  "name": "spotify-overlay",
  "version": "2.3.0",
  "description": "Cadence — a floating Spotify lyrics overlay: synced lyrics, 3D holographic frames, album theming, listen along with friends",
  "author": "Samahith Thellakal",
  "license": "MIT",
  "homepage": "https://github.com/MowkE/cadence",
  "repository": {
    "type": "git",
    "url": "https://github.com/MowkE/cadence.git"
  },
  "main": "main.js",
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.samahith.cadence",
    "productName": "Cadence",
    "artifactName": "Cadence-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "assets/icon.png",
      "assets/tray.png",
      "assets/tray@2x.png"
    ],
    "afterPack": "build/afterPack.js",
    "protocols": [
      {
        "name": "Cadence",
        "schemes": ["cadence"]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Cadence reads what's playing in Spotify and controls playback for you."
      }
    },
    "dmg": {
      "sign": false,
      "artifactName": "Cadence-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cadence",
      "artifactName": "Cadence-win-${arch}-Setup.${ext}"
    }
  }
}
